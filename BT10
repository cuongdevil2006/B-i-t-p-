import java.util.Scanner;
public class Bai10 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Nhap vao mot so: ");
        int n = Math.abs(sc.nextInt());        
        int dem = 0;
        if (n == 0) dem = 1;
        else {
            while (n > 0) {
                n /= 10;
                dem++;
            }
        }
        
        System.out.println("So luong chu so: " + dem);
    }
}
